# Copy this file to terraform.tfvars and fill in environment-specific values.
# Never commit terraform.tfvars with real secrets to version control.

environment = "qa"
aws_region  = "us-east-1"

# Path to your SSH public key (e.g. generated with ssh-keygen -t ed25519 -f ssh-keys/key-pair)
public_key_path = "./ssh-keys/key-pair.pub"

# Restrict SSH access to your operator IP (e.g., "203.0.113.10/32")
allowed_ssh_cidr = "0.0.0.0/0"

# VPC
vpc_name            = "movie-analyst-vpc"
vpc_cidr            = "10.0.0.0/16"
vpc_azs             = ["us-east-1a", "us-east-1b"]
vpc_public_subnets  = ["10.0.1.0/24", "10.0.2.0/24"]
vpc_private_subnets = ["10.0.101.0/24", "10.0.102.0/24"]

# AMIs (Example: Ubuntu 24.04 LTS in us-east-1 — replace with current AMI ID)
frontend_ami = "ami-0e2c8caa4b6378d8c"
backend_ami  = "ami-0e2c8caa4b6378d8c"
ansible_ami  = "ami-0e2c8caa4b6378d8c"

# Instance Types
frontend_instance_type = "t3.micro"
backend_instance_type  = "t3.micro"
ansible_instance_type  = "t3.micro"

# Auto Scaling
frontend_autoscaling_min_size         = 2
frontend_autoscaling_max_size         = 4
frontend_autoscaling_desired_capacity = 2

backend_autoscaling_min_size         = 2
backend_autoscaling_max_size         = 4
backend_autoscaling_desired_capacity = 2
backend_app_port                     = 3000

# RDS MySQL (provide mysql_password via TF_VAR_mysql_password or locally in terraform.tfvars)
mysql_username     = "admin"
mysql_password     = "CHANGE_ME_STRONG_PASSWORD"
rds_db_name        = "movie_db"
rds_instance_class = "db.t3.micro"
rds_multi_az       = true
